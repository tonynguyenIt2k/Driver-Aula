{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Root user document owning saved Open AULA profiles and macros.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 512
        },
        "selectedDeviceId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activeProfile": {
          "type": "integer"
        },
        "lang": {
          "type": "string",
          "enum": ["vi", "en"],
          "maxLength": 4
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "User Private Info",
      "description": "Isolated PII record containing verified Google account email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "DeviceProfileConfig": {
      "title": "Device Profile Config",
      "description": "Saved per-device and per-profile keymaps, RGB lighting, system settings, screen overlay settings, and mouse DPI settings.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileSlot": {
          "type": "integer"
        },
        "keymaps": {
          "type": "object"
        },
        "lighting": {
          "type": "object"
        },
        "systemSettings": {
          "type": "object"
        },
        "mouseConfig": {
          "type": "object"
        },
        "screenSettings": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "deviceId", "profileSlot", "keymaps", "lighting", "createdAt", "updatedAt"]
    },
    "SavedMacro": {
      "title": "Saved Macro",
      "description": "User-created keyboard/mouse macro sequence synced across sessions.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "macroId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "repeatMode": {
          "type": "string",
          "enum": ["once", "hold", "toggle"],
          "maxLength": 16
        },
        "actions": {
          "type": "array"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "macroId", "name", "repeatMode", "actions", "createdAt", "updatedAt"]
    },
    "BridgeStatus": {
      "title": "PC Hardware Bridge Status",
      "description": "Live status of the desktop WebHID host connected to the physical AULA keyboard or mouse.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "online": {
          "type": "boolean"
        },
        "hidConnected": {
          "type": "boolean"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "maxLength": 120
        },
        "connectionType": {
          "type": "string",
          "enum": ["wired", "wireless_2.4g", "bluetooth", "disconnected"],
          "maxLength": 24
        },
        "batteryLevel": {
          "type": "number"
        },
        "clientHostId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "online", "hidConnected", "deviceId", "productName", "connectionType", "clientHostId", "createdAt", "updatedAt"]
    },
    "RemoteCommand": {
      "title": "Remote Hardware Command",
      "description": "Remote execution command dispatched from mobile/secondary client to the PC WebHID bridge.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commandId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "apply_lighting",
            "apply_keymap",
            "apply_macros",
            "apply_system",
            "apply_mouse",
            "sync_time",
            "upload_screen",
            "reset_keys",
            "factory_reset"
          ],
          "maxLength": 32
        },
        "deviceId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileSlot": {
          "type": "integer"
        },
        "layer": {
          "type": "integer"
        },
        "animId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "failed"],
          "maxLength": 16
        },
        "resultMessage": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "commandId", "senderId", "type", "deviceId", "profileSlot", "status", "createdAt", "updatedAt"]
    },
    "ScreenAnimationItem": {
      "title": "TFT Screen Animation / Wallpaper",
      "description": "User-imported or custom-edited TFT screen wallpaper / GIF animation synced across Phone and PC.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frames": {
          "type": "array"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "animId", "name", "width", "height", "frames", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user root document and app preferences."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII storage (Google email) strictly owned by userId."
    },
    "/users/{userId}/profiles/{profileKey}": {
      "schema": { "$ref": "#/entities/DeviceProfileConfig" },
      "description": "Device + profile slot settings (keymaps, lighting, system, mouse, screen HUD)."
    },
    "/users/{userId}/macros/{macroId}": {
      "schema": { "$ref": "#/entities/SavedMacro" },
      "description": "Custom keyboard & mouse macro sequences belonging to the signed-in user."
    },
    "/users/{userId}/bridge/{docId}": {
      "schema": { "$ref": "#/entities/BridgeStatus" },
      "description": "Live desktop WebHID host connection state for remote phone control."
    },
    "/users/{userId}/commands/{commandId}": {
      "schema": { "$ref": "#/entities/RemoteCommand" },
      "description": "Remote hardware command queue executed by the signed-in user's PC WebHID bridge."
    },
    "/users/{userId}/screenAnimations/{animId}": {
      "schema": { "$ref": "#/entities/ScreenAnimationItem" },
      "description": "User-imported or edited TFT screen wallpapers and GIF animations synced across devices."
    }
  }
}
