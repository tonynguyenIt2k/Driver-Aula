rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'selectedDeviceId', 'activeProfile', 'lang', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
        && (!('selectedDeviceId' in data) || (data.selectedDeviceId is string && data.selectedDeviceId.size() >= 1 && data.selectedDeviceId.size() <= 64 && data.selectedDeviceId.matches('^[a-zA-Z0-9_\\-]+$')))
        && (!('activeProfile' in data) || (data.activeProfile is int && data.activeProfile >= 1 && data.activeProfile <= 3))
        && (!('lang' in data) || (data.lang is string && data.lang.size() <= 4 && (data.lang == 'vi' || data.lang == 'en')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeviceProfileConfig(data, userId) {
      return data.keys().hasAll(['ownerId', 'deviceId', 'profileSlot', 'keymaps', 'lighting', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'deviceId', 'profileSlot', 'keymaps', 'lighting', 'systemSettings', 'mouseConfig', 'screenSettings', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64 && data.deviceId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.profileSlot is int && data.profileSlot >= 1 && data.profileSlot <= 3
        && data.keymaps is map && data.keymaps.size() <= 8
        && data.lighting is map && data.lighting.size() <= 24
        && (!('systemSettings' in data) || (data.systemSettings is map && data.systemSettings.size() <= 16))
        && (!('mouseConfig' in data) || (data.mouseConfig is map && data.mouseConfig.size() <= 16))
        && (!('screenSettings' in data) || (data.screenSettings is map && data.screenSettings.size() <= 16))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedMacro(data, userId, macroId) {
      return data.keys().hasAll(['ownerId', 'macroId', 'name', 'repeatMode', 'actions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'macroId', 'name', 'repeatMode', 'actions', 'clientCreatedAt', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.macroId is string && data.macroId.size() >= 1 && data.macroId.size() <= 128 && data.macroId == macroId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.repeatMode is string && data.repeatMode.size() <= 16 && (data.repeatMode == 'once' || data.repeatMode == 'hold' || data.repeatMode == 'toggle')
        && data.actions is list && data.actions.size() <= 128 && (data.actions.size() == 0 || data.actions[0] is map)
        && (!('clientCreatedAt' in data) || data.clientCreatedAt is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScreenAnimation(data, userId, animId) {
      return data.keys().hasAll(['ownerId', 'animId', 'name', 'width', 'height', 'frames', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'animId', 'name', 'width', 'height', 'frames', 'clientCreatedAt', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.animId is string && data.animId.size() >= 1 && data.animId.size() <= 128 && data.animId == animId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.width is int && data.width >= 32 && data.width <= 640
        && data.height is int && data.height >= 32 && data.height <= 640
        && data.frames is list && data.frames.size() >= 1 && data.frames.size() <= 141 && data.frames[0] is map
        && (!('clientCreatedAt' in data) || data.clientCreatedAt is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBridgeStatus(data, userId) {
      return data.keys().hasAll(['ownerId', 'online', 'hidConnected', 'deviceId', 'productName', 'connectionType', 'clientHostId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'online', 'hidConnected', 'deviceId', 'productName', 'connectionType', 'batteryLevel', 'clientHostId', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.online is bool
        && data.hidConnected is bool
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64 && data.deviceId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120
        && data.connectionType is string && data.connectionType.size() <= 24 && (data.connectionType == 'wired' || data.connectionType == 'wireless_2.4g' || data.connectionType == 'bluetooth' || data.connectionType == 'disconnected')
        && (!('batteryLevel' in data) || (data.batteryLevel is number && data.batteryLevel >= 0 && data.batteryLevel <= 100))
        && data.clientHostId is string && data.clientHostId.size() >= 1 && data.clientHostId.size() <= 64 && data.clientHostId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRemoteCommand(data, userId, commandId) {
      return data.keys().hasAll(['ownerId', 'commandId', 'senderId', 'type', 'deviceId', 'profileSlot', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'commandId', 'senderId', 'type', 'deviceId', 'profileSlot', 'layer', 'animId', 'status', 'resultMessage', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.commandId is string && data.commandId.size() >= 1 && data.commandId.size() <= 128 && data.commandId == commandId
        && data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 64 && data.senderId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.type is string && data.type.size() <= 32 && (
          data.type == 'apply_lighting'
          || data.type == 'apply_keymap'
          || data.type == 'apply_macros'
          || data.type == 'apply_system'
          || data.type == 'apply_mouse'
          || data.type == 'sync_time'
          || data.type == 'upload_screen'
          || data.type == 'reset_keys'
          || data.type == 'factory_reset'
        )
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64 && data.deviceId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.profileSlot is int && data.profileSlot >= 1 && data.profileSlot <= 3
        && (!('layer' in data) || (data.layer is int && data.layer >= 0 && data.layer <= 3))
        && (!('animId' in data) || (data.animId is string && data.animId.size() >= 1 && data.animId.size() <= 128 && data.animId.matches('^[a-zA-Z0-9_\\-]+$')))
        && data.status is string && data.status.size() <= 16 && (data.status == 'pending' || data.status == 'completed' || data.status == 'failed')
        && (!('resultMessage' in data) || (data.resultMessage is string && data.resultMessage.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'selectedDeviceId', 'activeProfile', 'lang', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && docId == 'info' && isVerifiedOwner(userId);
      }

      match /profiles/{profileKey} {
        allow get: if isValidId(userId) && isValidId(profileKey) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(profileKey)
          && isVerifiedOwner(userId)
          && isValidDeviceProfileConfig(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(profileKey)
          && isVerifiedOwner(userId)
          && isValidDeviceProfileConfig(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().deviceId == existing().deviceId
          && incoming().profileSlot == existing().profileSlot
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['keymaps', 'lighting', 'systemSettings', 'mouseConfig', 'screenSettings', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(profileKey) && isVerifiedOwner(userId);
      }

      match /macros/{macroId} {
        allow get: if isValidId(userId) && isValidId(macroId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(macroId)
          && isVerifiedOwner(userId)
          && isValidSavedMacro(incoming(), userId, macroId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(macroId)
          && isVerifiedOwner(userId)
          && isValidSavedMacro(incoming(), userId, macroId)
          && incoming().ownerId == existing().ownerId
          && incoming().macroId == existing().macroId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'repeatMode', 'actions', 'clientCreatedAt', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(macroId) && isVerifiedOwner(userId);
      }

      match /screenAnimations/{animId} {
        allow get: if isValidId(userId) && isValidId(animId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(animId)
          && isVerifiedOwner(userId)
          && isValidScreenAnimation(incoming(), userId, animId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(animId)
          && isVerifiedOwner(userId)
          && isValidScreenAnimation(incoming(), userId, animId)
          && incoming().ownerId == existing().ownerId
          && incoming().animId == existing().animId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'width', 'height', 'frames', 'clientCreatedAt', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(animId) && isVerifiedOwner(userId);
      }

      match /bridge/{docId} {
        allow get: if isValidId(userId) && docId == 'status' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'status'
          && isVerifiedOwner(userId)
          && isValidBridgeStatus(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && docId == 'status'
          && isVerifiedOwner(userId)
          && isValidBridgeStatus(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['online', 'hidConnected', 'deviceId', 'productName', 'connectionType', 'batteryLevel', 'clientHostId', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && docId == 'status' && isVerifiedOwner(userId);
      }

      match /commands/{commandId} {
        allow get: if isValidId(userId) && isValidId(commandId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(commandId)
          && isVerifiedOwner(userId)
          && isValidRemoteCommand(incoming(), userId, commandId)
          && incoming().status == 'pending'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(commandId)
          && isVerifiedOwner(userId)
          && isValidRemoteCommand(incoming(), userId, commandId)
          && existing().status == 'pending'
          && (incoming().status == 'completed' || incoming().status == 'failed')
          && incoming().ownerId == existing().ownerId
          && incoming().commandId == existing().commandId
          && incoming().senderId == existing().senderId
          && incoming().type == existing().type
          && incoming().deviceId == existing().deviceId
          && incoming().profileSlot == existing().profileSlot
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resultMessage', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(commandId) && isVerifiedOwner(userId);
      }
    }
  }
}
